# ---- Shared infra ----
MONGO_URI=mongodb://localhost:27017/veda
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
# Comma-separated origins allowed to call the API / open a socket
CORS_ORIGIN=http://localhost:3000

# ---- Worker / AI (Google Gemini) ----
# Get a FREE key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-real-key-here
# Free-tier model. gemini-2.5-flash is fast and free for this use.
GEMINI_MODEL=gemini-2.5-flash
# Cache generated papers in Redis keyed by a hash of the inputs (TTL seconds)
GENERATION_CACHE_TTL=86400

# ---- Web (Next.js, must be prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
